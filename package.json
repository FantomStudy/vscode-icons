{
  "name": "vscode-icons",
  "displayName": "Pierre Icons (Unofficial)",
  "version": "0.1.0",
  "description": "Independent fork of Pierre file icons with colored and monochrome Complete themes.",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "file-icons",
    "icon-theme",
    "icons",
    "pierre"
  ],
  "bugs": {
    "url": "https://github.com/FantomStudy/vscode-icons/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FantomStudy/vscode-icons"
  },
  "publisher": "fantomstudy",
  "type": "module",
  "scripts": {
    "build": "npm run format:svgs && npm run format:check && npm run lint && node scripts/build-icon-theme.mjs",
    "watch": "node scripts/watch-svgs.mjs",
    "package": "npm run build && node scripts/package-vsix.mjs",
    "lint": "oxlint scripts/",
    "format": "oxfmt scripts/",
    "format:check": "oxfmt --check scripts/",
    "format:svgs": "node scripts/format-svgs.mjs",
    "sizes": "node scripts/svg-sizes.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "svgo": "^4.0.1"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "fantomstudy-icons-minimal",
        "label": "Pierre Icons (Minimal, Unofficial)",
        "path": "./icons/theme-minimal.json"
      },
      {
        "id": "fantomstudy-icons",
        "label": "Pierre Icons (Unofficial)",
        "path": "./icons/theme-default.json"
      },
      {
        "id": "fantomstudy-icons-complete",
        "label": "Pierre Icons (Complete, Unofficial)",
        "path": "./icons/theme-complete.json"
      },
      {
        "id": "fantomstudy-icons-complete-monochrome",
        "label": "Pierre Icons (Complete Monochrome, Unofficial)",
        "path": "./icons/theme-complete-monochrome.json"
      }
    ]
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141415",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "private": true
}
